@online{ennisDiscoveryFunctionalityGlobal2026,
  title = {Discovery, Functionality and Global Dynamics of {{Bifidobacterium}} Longum Subsp. Nexti: A Novel Starch-Degrading Subspecies in the Infant Gut},
  shorttitle = {Discovery, Functionality and Global Dynamics of {{Bifidobacterium}} Longum Subsp. Nexti},
  author = {Ennis, Dena and Andreu-Sánchez, Sergio and Jayaprakash, Yuvashankar Kavanal and Sinha, Trishla and Peng, Haoran and Goldberger, Omer and Docherty, James A. D. and Kuzub, Nataliia and Fernández-Pato, Asier and Zhao, Shijie and Shao, Yan and Levin, Yarden and family=Study, given=LLNEXT, given-i=LLNEXT, prefix=cohort, useprefix=false and Amster-Choder, Orna and Lawley, Trevor D. and Weersma, Rinse K. and Alm, Eric and Collado, Maria Carmen and Fu, Jingyuan and Kurilshikov, Alexander and Harmsen, Hermie J. M. and Mallon, Cyrus A. and family=Sinderen, given=Douwe, prefix=van, useprefix=false and Zhernakova, Alexandra and Yassour, Moran},
  date = {2026-09-18},
  eprinttype = {bioRxiv},
  eprintclass = {New Results},
  pages = {2025.06.23.661074},
  issn = {2692-8205},
  doi = {10.1101/2025.06.23.661074},
  url = {https://www.biorxiv.org/content/10.1101/2025.06.23.661074v3},
  urldate = {2026-10-08},
  abstract = {Bifidobacterium longum is a foundational, genetically diverse member of the infant gut microbiome, yet resolving its subspecies in metagenomic data remains challenging. Here, we performed a deep phylogenetic characterization of the B. longum species utilizing 4,577 fecal metagenomes from the LLNEXT mother-infant cohort alongside a global dataset of 1,220 genomes and metagenome-assembled genomes (MAGs). We identified a novel, geographically widespread lineage: Bifidobacterium longum subsp. nexti. Using a polyphasic taxonomic analysis, including average nucleotide identity and digital DNA-DNA hybridization, confirms subspecies-level divergence. Distinct from other members of the B. longum species, BL. nexti harbors α-amylopullulanase and grows on soluble starch and often pullulan, consistent with α-glucan utilization. Within the LLNEXT cohort, BL. nexti is enriched in formula-fed infants and shows evidence consistent with vertical transmission. Globally, while BL. nexti is geographically widespread, it usually persists at low relative abundance across diverse populations. By resolving a major fraction of previously unclassified B. longum diversity, this study provides new insights into the specialized lineages and ecological dynamics driving the assembly of the developing infant microbiome.},
  langid = {english},
  pubstate = {prepublished},
  file = {/home/kevin/Zotero/storage/P2M7939Q/Ennis et al. - 2026 - Discovery, functionality and global dynamics of Bifidobacterium longum subsp. nexti a novel starch-.pdf}
}

@article{sakaguchiTargetedGeneKnockout2012,
  title = {A Targeted Gene Knockout Method Using a Newly Constructed Temperature-Sensitive Plasmid Mediated Homologous Recombination in {{Bifidobacterium}} Longum},
  author = {Sakaguchi, Kouta and He, Jianlong and Tani, Saori and Kano, Yasunobu and Suzuki, Tohru},
  date = {2012-07-01},
  journaltitle = {Applied Microbiology and Biotechnology},
  shortjournal = {Appl Microbiol Biotechnol},
  volume = {95},
  number = {2},
  pages = {499--509},
  issn = {1432-0614},
  doi = {10.1007/s00253-012-4090-4},
  url = {https://doi.org/10.1007/s00253-012-4090-4},
  urldate = {2025-09-26},
  abstract = {Bifidobacteria are the main component of the human microflora. We constructed a temperature-sensitive (Ts) plasmid by random mutagenesis of the Bifidobacterium–Escherichia coli shuttle vector pKKT427 using error-prone PCR. Mutant plasmids were introduced into Bifidobacterium longum 105-A and, after screening approximately 3,000 colonies, candidate clones that grew at 30~°C but not at 42~°C were selected. According to DNA sequence analysis of the Ts plasmid, five silent and one missense mutations were found in the repB region. The site-directed mutagenesis showed only the missense mutation to be relevant to the Ts phenotype. We designated this plasmid pKO403. The Ts phenotype was also observed in B. longum NCC2705 and Bifidobacterium adolescentis ATCC15703. Single-crossover homologous-recombination experiments were carried out to determine the relationship between the length of homologous sequences encoded on the plasmid and recombination frequency: fragments greater than 1~kb gave an efficiency of more than 103 integrations per cell. We performed gene knockout experiments using this Ts plasmid. We obtained gene knockout mutants of the pyrE region of B. longum 105-A, and determined that double-crossover homologous recombination occurred at an efficiency of 1.8~\%. This knockout method also worked for the BL0033 gene in B. longum NCC2705.},
  langid = {english},
  keywords = {Bifidobacteria,Gene knockout,Homologous recombination,Mutagenesis,Temperature-sensitive plasmid},
  file = {/home/kevin/Zotero/storage/2ICW8JE9/Sakaguchi et al. - 2012 - A targeted gene knockout method using a newly constructed temperature-sensitive plasmid mediated hom.pdf}
}
@article{altaibBifidobacteriumEscherichiaColiShuttle2022,
  title = {Bifidobacterium-{{Escherichia}} Coli {{Shuttle Vector Series pKO403}}, with {{Temperature-Sensitive Replication Origin}} for {{Gene Knockout}} in {{Bifidobacterium}}},
  author = {Altaib, Hend and Ozaki, Yuka and Kozakai, Tomoya and Sakaguchi, Kouta and Nomura, Izumi and Suzuki, Tohru},
